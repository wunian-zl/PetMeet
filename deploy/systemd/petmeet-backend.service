[Unit]
Description=PetMeet Spring Boot Backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=petmeet
Group=petmeet
WorkingDirectory=/opt/petmeet
EnvironmentFile=/etc/petmeet/petmeet.env
Environment="JAVA_OPTS=-Xms256m -Xmx768m"
ExecStart=/usr/bin/java $JAVA_OPTS -jar /opt/petmeet/PetMeet-backend.jar
Restart=always
RestartSec=5
SuccessExitStatus=143

[Install]
WantedBy=multi-user.target
