# Copy to /etc/petmeet/petmeet.env on the server and fill real secrets.
PETMEET_DB_URL=jdbc:mysql://127.0.0.1:3306/petmeet?useUnicode=true&characterEncoding=UTF-8&connectionCollation=utf8mb4_unicode_ci&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
PETMEET_DB_USER=petmeet
PETMEET_DB_PASSWORD=change-me
PETMEET_ADMIN_PASSWORD=change-me
PETMEET_REDIS_HOST=127.0.0.1
PETMEET_REDIS_PORT=6379
PETMEET_REDIS_PASSWORD=
PETMEET_UPLOAD_PATH=/opt/petmeet/uploads
PETMEET_UPLOAD_BASE_URL=/images
PETMEET_CORS_ALLOWED_ORIGINS=https://www.petmeet.xyz,https://petmeet.xyz,http://124.220.91.57,http://www.petmeet.xyz,http://petmeet.xyz
PETMEET_ALIPAY_ENABLED=false
PETMEET_ALIPAY_APP_ID=
PETMEET_ALIPAY_PRIVATE_KEY=
PETMEET_ALIPAY_PUBLIC_KEY=
PETMEET_ALIPAY_NOTIFY_URL=https://example.com/api/pay/alipay/notify
